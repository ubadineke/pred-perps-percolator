# Jupiter Prediction API credentials. Never commit a real key.
JUPITER_API_KEY=
JUPITER_PREDICTION_BASE_URL=https://api.jup.ag/prediction/v1

# Panta market discovery. Keep the key server-side; never use NEXT_PUBLIC_.
PANTA_API_KEY=
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_LIVE_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_STAGING_API_BASE_URL=https://staging-api.panta.market/api/v1
ORACLE_REPORT_INTERVAL_MS=10000

# Solana configuration
SOLANA_RPC_URL=http://127.0.0.1:8899
DEVNET_RPC_URL=https://api.devnet.solana.com
MOXIE_CLUSTER=localnet
PERCOLATOR_PROGRAM_ID=
MOXIE_MATCHER_PROGRAM_ID=
MOXIE_ORACLE_PROGRAM_ID=
MOXIE_USDC_MINT=
MOXIE_MARKET_ACCOUNT=
MOXIE_MARKET_AUTHORITY=
MOXIE_COLLATERAL_VAULT=
MOXIE_LP_PORTFOLIO=
MOXIE_MATCHER_CONTEXT=
MOXIE_MATCHER_DELEGATE=
MOXIE_API_URL=http://127.0.0.1:8787
MOXIE_PORTFOLIO_ADDRESS=

# Browser wallet configuration. The Privy app ID is public; never expose the
# Privy app secret or any private key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
